# Required API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
GOOGLE_API_KEY=

# Model Configuration (budget-friendly for mobile)
RESEARCH_MODEL=openai:gpt-4.1-mini
SUMMARIZATION_MODEL=openai:gpt-4.1-mini
COMPRESSION_MODEL=openai:gpt-4.1-mini
FINAL_REPORT_MODEL=openai:gpt-4.1-mini

# Search Configuration
SEARCH_API=tavily

# Performance (lower = faster & cheaper on mobile)
MAX_RESEARCHER_ITERATIONS=4
MAX_REACT_TOOL_CALLS=8
MAX_CONCURRENT_RESEARCH_UNITS=2
ALLOW_CLARIFICATION=false

# Optional LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false